model RefreshToken {
  /// * This is also the jti claim on the issued refresh JWT
  id           String    @id @default(uuid())
  customerId   String?
  staffId      String?
  expiresAt    DateTime
  revokedAt    DateTime?
  /// * If rotated, points at the row that replaced this one
  replacedById String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  /// * Optional UA / IP captured at issue time for audit
  userAgent    String?
  ipAddress    String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  staff        Staff?    @relation(fields: [staffId], references: [id])

  @@index([customerId])
  @@index([staffId])
  @@index([expiresAt])
}
