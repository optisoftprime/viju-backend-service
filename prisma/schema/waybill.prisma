enum LoadingRequestStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  LOADING_IN_PROGRESS
  COMPLETED
  CANCELLED
}

model LoadingRequest {
  id        String @id @default(uuid())
  reference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  region Region

  linkedPurchaseId String?
  linkedPurchase   Purchase? @relation(fields: [linkedPurchaseId], references: [id])

  truckPlateNumber     String
  driverName           String
  driverPhone          String
  requestedLoadingDate DateTime
  quantityCartons      Int?
  destination          String?

  termsAcceptedAt DateTime
  externalFormUrl String?

  status LoadingRequestStatus @default(PENDING_ASSIGNMENT)

  assignedOfficerId String?
  assignedOfficer   Staff?    @relation("LoadingOfficerToRequest", fields: [assignedOfficerId], references: [id])
  assignedAt        DateTime?
  assignedById      String?

  loadingStartedAt DateTime?
  completedAt      DateTime?

  /// L-2 - the loading officer's free-text note on this load, e.g. "customer
  /// loading 800 cartons on 26/08/2026, remaining a balance of 200 cartons".
  /// Written and corrected independently of `status`, which is why it has its
  /// own route. Null when never written; an empty save clears it back to null.
  description String?

  /// TS-1 - when `description` was last written. Deliberately NOT `updatedAt`:
  /// every status change bumps that, so on a completed load it would date the
  /// note to the moment the load finished. The value of a handover note is
  /// WHEN THE COUNT WAS TAKEN, and a wrong timestamp on one is worse than
  /// none. Set with the description, cleared to null when it is cleared, and
  /// left alone by a status change.
  descriptionUpdatedAt DateTime?

  /// L-1 - when the load was called off, and why. `cancelReason` is optional:
  /// an operator who gives no reason leaves it null rather than blank, so
  /// "no reason recorded" and "reason was empty" cannot be confused.
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  waybillDocumentUrl String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([region])
  @@index([assignedOfficerId])
  @@index([status])
}

model TermsAcceptance {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  termsVersion String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([customerId])
}
