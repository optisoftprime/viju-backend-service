enum LoadingRequestStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  LOADING_IN_PROGRESS
  COMPLETED
  CANCELLED
}

model LoadingRequest {
  id        String @id @default(uuid())
  reference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  region Region

  linkedPurchaseId String?
  linkedPurchase   Purchase? @relation(fields: [linkedPurchaseId], references: [id])

  truckPlateNumber     String
  driverName           String
  driverPhone          String
  requestedLoadingDate DateTime
  quantityCartons      Int?
  destination          String?

  /// The Viju warehouse the truck is loading from. Stored as text rather than
  /// an enum because the wire value carries a space ("LAGOS WAREHOUSE") and a
  /// Postgres enum label cannot round-trip that without a mapping layer that
  /// would only ever hide the raw value. Validated against the closed set at
  /// the DTO. Null on requests raised before the field existed.
  warehouseName String?

  /// The TRUCK's carton capacity, as the distributor states it - not the size
  /// of this load. The load itself is the sum of `items.quantity`, mirrored
  /// onto `quantityCartons` so every existing stock calculation keeps working.
  loadingCapacity Int?

  /// The products being loaded. Empty on requests raised before the field
  /// existed, and on any raised without a product breakdown.
  items LoadingRequestItem[]

  termsAcceptedAt DateTime
  externalFormUrl String?

  status LoadingRequestStatus @default(PENDING_ASSIGNMENT)

  assignedOfficerId String?
  assignedOfficer   Staff?    @relation("LoadingOfficerToRequest", fields: [assignedOfficerId], references: [id])
  assignedAt        DateTime?
  assignedById      String?

  loadingStartedAt DateTime?
  completedAt      DateTime?

  /// L-2 - the loading officer's free-text note on this load, e.g. "customer
  /// loading 800 cartons on 26/08/2026, remaining a balance of 200 cartons".
  /// Written and corrected independently of `status`, which is why it has its
  /// own route. Null when never written; an empty save clears it back to null.
  description String?

  /// TS-1 - when `description` was last written. Deliberately NOT `updatedAt`:
  /// every status change bumps that, so on a completed load it would date the
  /// note to the moment the load finished. The value of a handover note is
  /// WHEN THE COUNT WAS TAKEN, and a wrong timestamp on one is worse than
  /// none. Set with the description, cleared to null when it is cleared, and
  /// left alone by a status change.
  descriptionUpdatedAt DateTime?

  /// L-1 - when the load was called off, and why. `cancelReason` is optional:
  /// an operator who gives no reason leaves it null rather than blank, so
  /// "no reason recorded" and "reason was empty" cannot be confused.
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  waybillDocumentUrl String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([region])
  @@index([assignedOfficerId])
  @@index([status])
}

model TermsAcceptance {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  termsVersion String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([customerId])
}

/// One product line on a loading request.
///
/// The distributor picks these from GET /erp/orders/{orderId}/products, so the
/// values originate in the ERP sales-order feed and the Viju product
/// specification sheet. They are stored as sent rather than re-resolved: this
/// is a record of what the distributor declared they were loading, and it must
/// not silently change if the specification sheet is later corrected.
model LoadingRequestItem {
  id String @id @default(uuid())

  loadingRequestId String
  loadingRequest   LoadingRequest @relation(fields: [loadingRequestId], references: [id], onDelete: Cascade)

  /// The order this line was taken from. A single loading request can span
  /// several orders, so the order lives on the LINE, not on the request -
  /// `LoadingRequest.linkedPurchaseId` names only the primary one.
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  /// The ERP DOC_NO of that order, denormalised so a line can still say where
  /// it came from if the local Purchase row is ever removed.
  orderReference String?

  /// ERP item code from the specification sheet. Null when the sheet does not
  /// cover the product - the products endpoint returns null there too.
  productId String?

  /// ITEM_DESCRIPTION as the ERP states it.
  productName String

  /// Cartons of this product on the load.
  quantity Int

  /// Kilograms per carton, as the specification sheet states it. Null when the
  /// sheet does not cover the product.
  weightPerCarton Float?

  createdAt DateTime @default(now())

  @@index([loadingRequestId])
  @@index([purchaseId])
}
