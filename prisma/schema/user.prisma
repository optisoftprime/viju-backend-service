enum StaffRole {
  ADMIN
  OFFICER
  REGIONAL_ADMIN
  LOADING_OFFICER
  WAREHOUSE_OFFICER
}

enum AccountStatus {
  ACTIVE
  ON_HOLD
}

model Customer {
  id                 String        @id @default(uuid())
  erpId              String        @unique
  name               String
  phone              String        @unique
  email              String?
  password           String?
  profilePhotoUrl    String?
  accountStatus      AccountStatus @default(ACTIVE)
  outstandingBalance Float         @default(0.0)
  region             Region

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  assignedOfficerId String?
  assignedOfficer   Staff?  @relation("OfficerToCustomer", fields: [assignedOfficerId], references: [id])

  officerAssignments CustomerOfficer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases        Purchase[]
  payments         Payment[]
  messages         Message[]
  supportTickets   SupportTicket[]
  ticketReplies    TicketReply[]
  notifications    Notification[]
  pushTokens       PushToken[]
  loadingRequests  LoadingRequest[]
  termsAcceptances TermsAcceptance[]
  broadcasts       Broadcast[]       @relation("BroadcastToCustomer")
  refreshTokens    RefreshToken[]
}

/// Staff accounts.
///
/// ADMIN, REGIONAL_ADMIN, OFFICER (account officer) and LOADING_OFFICER are
/// INTERNALLY MANAGED: an ADMIN creates, deactivates and reactivates them
/// through /admin/officers and this table is the source of truth. An ERP sync
/// never creates them and never writes their role, region or isActive - see
/// src/common/roles/managed-roles.ts and AuthService.staffWebLogin.
///
/// WAREHOUSE_OFFICER is still mirrored from the ERP at web login.
model Staff {
  id       String    @id @default(uuid())
  role     StaffRole
  name     String
  email    String    @unique
  phone    String    @unique
  username String?   @unique
  erpCode  String?
  password String?
  /// Locally owned account status. Only an ADMIN moves it (US-15.4); an ERP
  /// sync can neither deactivate nor resurrect an account (US-15.5).
  isActive Boolean   @default(true)
  region   Region?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  /// Audit trail for the admin-managed lifecycle. Each *ById points at the
  /// ADMIN who performed the action; SetNull so removing an admin never
  /// deletes the account they touched.
  createdById  String?
  createdBy    Staff?  @relation("StaffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdStaff Staff[] @relation("StaffCreatedBy")

  deactivatedAt    DateTime?
  deactivatedById  String?
  deactivatedBy    Staff?    @relation("StaffDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deactivatedStaff Staff[]   @relation("StaffDeactivatedBy")

  reactivatedAt    DateTime?
  reactivatedById  String?
  reactivatedBy    Staff?    @relation("StaffReactivatedBy", fields: [reactivatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reactivatedStaff Staff[]   @relation("StaffReactivatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers           Customer[]        @relation("OfficerToCustomer")
  customerAssignments CustomerOfficer[] @relation("StaffToCustomerAssignment")
  messages            Message[]
  ticketReplies       TicketReply[]
  notifications       Notification[]
  pushTokens          PushToken[]
  loadingRequests     LoadingRequest[]  @relation("LoadingOfficerToRequest")
  broadcastsSent      Broadcast[]       @relation("StaffToBroadcast")
  refreshTokens       RefreshToken[]

  @@index([role, isActive])
}

model OtpVerification {
  id          String    @id @default(uuid())
  phone       String
  code        String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone])
}
