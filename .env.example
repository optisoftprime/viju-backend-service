# IMPORTANT: anything other than "production" enables dev mode, where OTPs
# are returned in the request-otp response body. Always set to "production"
# in prod environments. App fails closed (treats unset as production).
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viju?schema=public

JWT_SECRET=your-super-secret-key-change-in-production
# Access token TTL — short. Format: 30s | 5m | 1h | 1d
JWT_EXPIRATION=1h
# Refresh token TTL — long. Refresh tokens are stored in DB + rotated on use.
JWT_REFRESH_EXPIRATION=30d

# ─── Push notifications (PRD §6) ─────────────────────────
# Set PUSH_PROVIDER=fcm to enable Firebase Cloud Messaging.
# Anything else (incl. unset) uses the console logger.
PUSH_PROVIDER=console

# Firebase credentials — supply ONE of the three forms below:
#
# 1. Inline JSON (recommended for container deploys):
#    FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#
# 2. Path to a service-account JSON file mounted into the container:
#    FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
#
# 3. Individual fields (FIREBASE_PRIVATE_KEY may use literal \n for newlines):
#    FIREBASE_PROJECT_ID=viju-distribution
#    FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@viju-distribution.iam.gserviceaccount.com
#    FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Email (PRD F18 AC4, F11 etc.) ───────────────────────
# EMAIL_PROVIDER=resend  → Resend HTTP API
# EMAIL_PROVIDER=smtp    → SMTP (Gmail/Mailgun/Postmark/etc.)
# anything else / unset  → console logger (dev default)
EMAIL_PROVIDER=console

EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Viju

# Resend (when EMAIL_PROVIDER=resend) — get a key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# SMTP (when EMAIL_PROVIDER=smtp) — Gmail / Optisoft / Mailgun / etc.
#
# For Gmail: enable 2FA + create an App Password (Google Account →
# Security → App passwords). Use the 16-char string as SMTP_PASS,
# leave SMTP_PORT=587 and SMTP_SECURE unset (STARTTLS).
#
# For Optisoft / other provider on port 465: set SMTP_SECURE=true
# (TLS on connect). Spring-style SPRING_MAIL_* env names are also
# accepted as aliases for the SMTP_* vars below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=true                # force TLS on connect (port 465)
# SMTP_CONNECTION_TIMEOUT=10000   # ms; defaults to 10000
# SMTP_SOCKET_TIMEOUT=10000       # ms; defaults to 10000

# ─── ERP webhooks (POST /erp/sync/*) ─────────────────────
# Shared secret the ERP must send as the `x-api-key` header on every sync
# webhook. REQUIRED in production — if unset, the app rejects all ERP calls
# (fail-closed). In dev it may be left unset (webhooks run unauthenticated).
ERP_API_KEY=

# How often (ms) to re-derive order statuses from the erp_raw sales-order feed,
# so orders stop reading "Processing" after the ERP has moved them on.
# Defaults to 900000 (15 min). Values under 60000 are raised to 60000.
# Set to 0 to disable the timer and rely solely on the ingest service calling
# POST /erp/sync/order-status after each projector run.
# ERP_ORDER_STATUS_SYNC_INTERVAL_MS=900000

# How often (ms) to copy ERP customers into the portal, so a region the
# external projector has not reached stops rendering empty. Same rules as
# above: defaults to 900000 (15 min), values under 60000 are raised to 60000,
# 0 disables the timer and leaves only POST /erp/sync/customers.
# ERP_CUSTOMER_PROJECTION_INTERVAL_MS=900000

# How often (ms) to re-derive customer account balances from the erp_raw
# customer-credit feed, as CREDIT_AMT + CREDIT_AMT1 - CREDIT_PAY.
# DEFAULTS TO 0 (disabled), unlike the order-status reconcile above: a pass
# resets the immediate delivery-allowance bump (PRD F15 AC5) to the ERP's
# figure until the next ingest books it. Prefer having the ingest service call
# POST /erp/sync/account-balance once its customer-credit projector run
# finishes, when the ERP figures are known to be fresh.
# Values under 60000 are raised to 60000.
# ERP_ACCOUNT_BALANCE_SYNC_INTERVAL_MS=0

# ─── Default account officer (LAGOS only) ──────────────────
# Customers arrive from the ERP with no account officer (the ingest projector
# knows nothing about staff), which leaves them invisible to the officer portal
# and unreachable by chat, tickets and notifications. Every LAGOS customer
# whose officer is unset is parked on this one, matched by Staff.email — the
# account must be an ACTIVE staff member with role=OFFICER.
#
# Defaults to james.o@viju.example when unset. An admin reassignment
# (PATCH /admin/customers/{id}/reassign) always wins: a customer who already
# has an officer is never touched again.
# DEFAULT_ACCOUNT_OFFICER_EMAIL=james.o@viju.example

# The ONLY region parked automatically. Customers in EASTERN, SOUTH_SOUTH,
# WESTERN and NORTH are deliberately left unassigned for a regional officer to
# pick up — officers are region-scoped (PRD Section 8), and bulk reassignment
# away from an officer only offers officers in that officer's own region, so a
# cross-region portfolio could never be unwound.
#
# Defaults to LAGOS. An unrecognised value falls back to LAGOS with a warning
# rather than widening the scope. Point DEFAULT_ACCOUNT_OFFICER_EMAIL at an
# officer posted to the SAME region when changing this.
# DEFAULT_ACCOUNT_OFFICER_REGION=LAGOS

# How often (ms) to park newly-arrived unassigned LAGOS customers on that officer.
# Defaults to 900000 (15 min). Values under 60000 are raised to 60000.
# Set to 0 to disable the timer and rely solely on the ingest service calling
# POST /erp/sync/default-officer after each customer projector run.
# DEFAULT_OFFICER_SYNC_INTERVAL_MS=900000

# ─── External loading form (PRD F5) ──────────────────────
LOADING_FORM_URL=https://forms.example.com/viju-loading

# ─── File storage (POST /uploads) ────────────────────────
# STORAGE_PROVIDER=cloudinary → Cloudinary (CLOUDINARY_* below)
# STORAGE_PROVIDER=local      → local disk (writes under UPLOAD_DIR)
# unset                       → auto: cloudinary if creds present, else local
STORAGE_PROVIDER=local

# Cloudinary — supply either CLOUDINARY_URL or the three discrete vars.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local disk fallback (when STORAGE_PROVIDER=local):
# Files are served publicly at <origin>/uploads/<key>. To make the upload
# response return an ABSOLUTE public URL, set PUBLIC_BASE_URL to the API's
# public origin (or UPLOAD_PUBLIC_BASE to a full base). Otherwise the URL is
# the same-origin relative path /uploads/<key>.
# PUBLIC_BASE_URL=https://dev-api-viju.optisoft.com.ng
# UPLOAD_DIR=uploads
# UPLOAD_PUBLIC_BASE=https://cdn.example.com/uploads

# ─── OTP provider ──────────────────────────────────────────────────────────
# Which service sends/validates the phone-login OTP.
#   OTP_PROVIDER=local  → app generates the code, stores it, sends via SMS_PROVIDER,
#                         and validates it (default; dev returns the code in the
#                         request-otp response when NODE_ENV != production).
#   OTP_PROVIDER=ezone  → Ezone generates, SMS-delivers and validates the code.
OTP_PROVIDER=local

# Ezone OTP service (only used when OTP_PROVIDER=ezone).
EZONE_OTP_BASE_URL=https://gateway.ezoneapps.com:30002/ezone-api-authservice/api/v1/otp
# x-env header, required by the gateway: "test" for test keys (sk_test_/pk_test_),
# the live value per Ezone for live keys. Keys and EZONE_ENV must match.
EZONE_ENV=test
# x-org-key: the Organization Key, labelled "Organization Key" in the Ezone
# dashboard (ORG-…).
EZONE_ORGANIZATION_KEY=
# x-secret-key: the PRIVATE key (sk_…), labelled "Private Secret Key".
# NOT the public key — a pk_… value is refused at start-up with a clear error.
PRIVATE_EZONE_SECRET_KEY=
# The public key (pk_…) is the client-side key. It is NOT used by this service;
# set it only if some other consumer needs it.
# PUBLIC_EZONE_SECRET_KEY=
#
# The original shorter names are still accepted as a fallback, so an existing
# deployment keeps working without being re-keyed:
# EZONE_ORG_KEY=
# EZONE_SECRET_KEY=

# ─── Contact form (CC-05) ──────────────────────────────────────────────────
# Where enquiries from the public /contact form are emailed. Submissions are
# always stored; with this unset nobody is notified and a warning is logged.
# The route is rate-limited to 5 submissions per IP per hour.
# CONTACT_INBOX_EMAIL=sales@viju.example
