# IMPORTANT: anything other than "production" enables dev mode, where OTPs
# are returned in the request-otp response body. Always set to "production"
# in prod environments. App fails closed (treats unset as production).
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viju?schema=public

JWT_SECRET=your-super-secret-key-change-in-production
# Access token TTL — short. Format: 30s | 5m | 1h | 1d
JWT_EXPIRATION=1h
# Refresh token TTL — long. Refresh tokens are stored in DB + rotated on use.
JWT_REFRESH_EXPIRATION=30d

# ─── Push notifications (PRD §6) ─────────────────────────
# Set PUSH_PROVIDER=fcm to enable Firebase Cloud Messaging.
# Anything else (incl. unset) uses the console logger.
PUSH_PROVIDER=console

# Firebase credentials — supply ONE of the three forms below:
#
# 1. Inline JSON (recommended for container deploys):
#    FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#
# 2. Path to a service-account JSON file mounted into the container:
#    FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
#
# 3. Individual fields (FIREBASE_PRIVATE_KEY may use literal \n for newlines):
#    FIREBASE_PROJECT_ID=viju-distribution
#    FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@viju-distribution.iam.gserviceaccount.com
#    FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Email (PRD F18 AC4, F11 etc.) ───────────────────────
# EMAIL_PROVIDER=resend  → Resend HTTP API
# EMAIL_PROVIDER=smtp    → SMTP (Gmail/Mailgun/Postmark/etc.)
# anything else / unset  → console logger (dev default)
EMAIL_PROVIDER=console

EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Viju

# Resend (when EMAIL_PROVIDER=resend) — get a key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# SMTP (when EMAIL_PROVIDER=smtp) — Gmail example below.
# For Gmail: enable 2FA on the Google account then create an App Password
# (Google Account → Security → App passwords). Use the 16-char string as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=true  # force TLS on port 465; leave unset for 587 STARTTLS

# ─── External loading form (PRD F5) ──────────────────────
LOADING_FORM_URL=https://forms.example.com/viju-loading
