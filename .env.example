# IMPORTANT: anything other than "production" enables dev mode, where OTPs
# are returned in the request-otp response body. Always set to "production"
# in prod environments. App fails closed (treats unset as production).
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viju?schema=public

JWT_SECRET=your-super-secret-key-change-in-production
# Access token TTL — short. Format: 30s | 5m | 1h | 1d
JWT_EXPIRATION=1h
# Refresh token TTL — long. Refresh tokens are stored in DB + rotated on use.
JWT_REFRESH_EXPIRATION=30d

# ─── Push notifications (PRD §6) ─────────────────────────
# Set PUSH_PROVIDER=fcm to enable Firebase Cloud Messaging.
# Anything else (incl. unset) uses the console logger.
PUSH_PROVIDER=console

# Firebase credentials — supply ONE of the three forms below:
#
# 1. Inline JSON (recommended for container deploys):
#    FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#
# 2. Path to a service-account JSON file mounted into the container:
#    FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
#
# 3. Individual fields (FIREBASE_PRIVATE_KEY may use literal \n for newlines):
#    FIREBASE_PROJECT_ID=viju-distribution
#    FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@viju-distribution.iam.gserviceaccount.com
#    FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Email (PRD F18 AC4, F11 etc.) ───────────────────────
# EMAIL_PROVIDER=resend  → Resend HTTP API
# EMAIL_PROVIDER=smtp    → SMTP (Gmail/Mailgun/Postmark/etc.)
# anything else / unset  → console logger (dev default)
EMAIL_PROVIDER=console

EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Viju

# Resend (when EMAIL_PROVIDER=resend) — get a key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# SMTP (when EMAIL_PROVIDER=smtp) — Gmail / Optisoft / Mailgun / etc.
#
# For Gmail: enable 2FA + create an App Password (Google Account →
# Security → App passwords). Use the 16-char string as SMTP_PASS,
# leave SMTP_PORT=587 and SMTP_SECURE unset (STARTTLS).
#
# For Optisoft / other provider on port 465: set SMTP_SECURE=true
# (TLS on connect). Spring-style SPRING_MAIL_* env names are also
# accepted as aliases for the SMTP_* vars below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=true                # force TLS on connect (port 465)
# SMTP_CONNECTION_TIMEOUT=10000   # ms; defaults to 10000
# SMTP_SOCKET_TIMEOUT=10000       # ms; defaults to 10000

# ─── ERP webhooks (POST /erp/sync/*) ─────────────────────
# Shared secret the ERP must send as the `x-api-key` header on every sync
# webhook. REQUIRED in production — if unset, the app rejects all ERP calls
# (fail-closed). In dev it may be left unset (webhooks run unauthenticated).
ERP_API_KEY=

# ─── External loading form (PRD F5) ──────────────────────
LOADING_FORM_URL=https://forms.example.com/viju-loading

# ─── File storage (POST /uploads) ────────────────────────
# STORAGE_PROVIDER=cloudinary → Cloudinary (CLOUDINARY_* below)
# STORAGE_PROVIDER=local      → local disk (writes under UPLOAD_DIR)
# unset                       → auto: cloudinary if creds present, else local
STORAGE_PROVIDER=local

# Cloudinary — supply either CLOUDINARY_URL or the three discrete vars.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local disk fallback (when STORAGE_PROVIDER=local):
# Files are served publicly at <origin>/uploads/<key>. To make the upload
# response return an ABSOLUTE public URL, set PUBLIC_BASE_URL to the API's
# public origin (or UPLOAD_PUBLIC_BASE to a full base). Otherwise the URL is
# the same-origin relative path /uploads/<key>.
# PUBLIC_BASE_URL=https://dev-api-viju.optisoft.com.ng
# UPLOAD_DIR=uploads
# UPLOAD_PUBLIC_BASE=https://cdn.example.com/uploads
